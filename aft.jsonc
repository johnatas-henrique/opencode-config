{
  "$schema": "https://raw.githubusercontent.com/cortexkit/aft/main/assets/aft.schema.json",
  "hoist_builtin_tools": true,
  "format_on_edit": true,
  "validate_on_edit": "syntax",
  "tool_surface": "all",
  "search_index": true,
  "semantic_search": true,
  "restrict_to_project_root": false,
  "auto_update": true,
  "max_callgraph_files": 5000,
  "lsp": {
    "auto_install": true
  },
  "inspect": {
    "enabled": true
  },
  "experimental": {
    "lsp_ty": false
  },
  "bash": {
    "rewrite": true,
    "compress": true,
    "background": true
  }
}
