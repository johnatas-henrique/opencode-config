{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "disable_paste_summary": true
  },
  "autoupdate": true,
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/.config/opencode/docs/agent-instructions/workflow.md",
    "~/.config/opencode/docs/agent-instructions/mcp-tools.md",
    "~/.config/opencode/docs/agent-instructions/testing.md",
    "~/.config/opencode/docs/agent-instructions/constraints.md",
    "~/.config/opencode/docs/agent-instructions/writing-style.md"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "playwriter": {
      "enabled": true,
      "type": "local",
      "command": ["playwriter"]
    },
    "markitdown": {
      "command": ["uvx", "markitdown-mcp@latest"],
      "enabled": true,
      "type": "local"
    },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow"
    },
    "skill": "allow",
    "task": {
      "*": "allow"
    },
    "tool": {
      "*": "allow"
    },
    "webfetch": "deny",
    "bash": {
      "*": "allow",
      "rm -f *": "ask",
      "rm -rf *": "ask",
      "dd *": "ask",
      "git checkout *": "ask",
      "git reset *": "ask",
      "git restore *": "ask",
      "git clean *": "ask",
      "git push *": "ask",
      "sh -c *": "ask",
      "git add .": "deny"
    }
  },
  "plugin": [
    "@cortexkit/aft-opencode@latest",
    "@tarquinen/opencode-dcp@latest",
    "@franlol/opencode-md-table-formatter@latest",
    // "@gotgenes/opencode-agent-identity",
    "@johnatas-henrique/opencode-hooks@latest",
    "opencode-handoff",
    "./plugins/agentmemory-capture.ts"
  ],
  "server": {
    "cors": ["http://localhost"],
    "hostname": "0.0.0.0",
    "mdns": true,
    "port": 4096
  }
}
