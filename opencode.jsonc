          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "kimi": {
          "id": "kimi",
          "name": "kimi | 262K/16K | [IMAGE]",
          "limit": {
            "context": 262000,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "gemini-large": {
          "id": "gemini-large",
          "name": "gemini-large | 1M/32K | [IMAGE/AUDIO/VIDEO]",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image", "audio", "video"],
            "output": ["text"]
          }
        },
        "nova-fast": {
          "id": "nova-fast",
          "name": "nova-fast | 128K/4K",
          "limit": {
            "context": 128000,
            "output": 4096
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "glm": {
          "id": "glm",
          "name": "glm | 198K/8K",
          "limit": {
            "context": 198000,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "minimax": {
          "id": "minimax",
          "name": "minimax | 200K/8K",
          "limit": {
            "context": 200000,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/.config/opencode/docs/agent-instructions/process.md",
    "~/.config/opencode/docs/agent-instructions/workflow.md",
    "~/.config/opencode/docs/agent-instructions/mcp-tools.md",
    "~/.config/opencode/docs/agent-instructions/testing.md",
    "~/.config/opencode/docs/agent-instructions/constraints.md",
    "~/.config/opencode/docs/agent-instructions/safety-git.md",
    "~/.config/opencode/docs/agent-instructions/output.md",
    "~/.config/opencode/docs/agent-instructions/gitnexus.md",
    "~/.config/opencode/docs/agent-instructions/writing-style.md"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "playwright": {
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false,
      "type": "local"
    },
    "fff": {
      "enabled": true,
      "type": "local",
      "command": ["fff-mcp"]
    },
    "gitnexus": {
      "enabled": true,
      "type": "local",
      "command": ["gitnexus", "mcp"]
    },
    "playwriter": {
      "enabled": true,
      "type": "local",
      "command": ["playwriter"]
    },
    "markitdown": {
      "command": ["uvx", "markitdown-mcp@latest"],
      "enabled": false,
      "type": "local"
    },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow"
    },
    "skill": "allow",
    "task": {
      "*": "allow"
    },
    "tool": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -f *": "ask",
      "rm -rf *": "ask",
      "dd *": "ask",
      "git checkout *": "ask",
      "git reset *": "ask",
      "git restore *": "ask",
      "git clean *": "ask",
      "git push *": "ask",
      "sh -c *": "ask",
      "git add .": "deny"
    }
  },
  "plugin": [
    "./plugins/agentmemory-capture.ts",
    "opencode-handoff",
    "@gotgenes/opencode-agent-identity",
    "@franlol/opencode-md-table-formatter@latest",
    "@cortexkit/aft-opencode@latest",
    "@cortexkit/opencode-magic-context@latest"
  ],
  "server": {
    "cors": ["http://localhost"],
    "hostname": "0.0.0.0",
    "mdns": true,
    "port": 4096
  }
}
