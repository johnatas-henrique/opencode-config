{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": false,
  "small_model": "opencode/x-preview-f-free",
  "subagent_depth": 2,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "agent": {
    "build": {
      "prompt": "{file:~/.config/opencode/docs/prompts/default.md}",
      "model": "opencode-go/deepseek-v4-flash"
    },
    "plan": {
      "prompt": "{file:~/.config/opencode/docs/prompts/default.md}",
      "model": "opencode-go/deepseek-v4-flash"
    },
    "general": {
      "prompt": "{file:~/.config/opencode/docs/prompts/general.md}",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash"
    },
    "explore": {
      "prompt": "{file:~/.config/opencode/docs/prompts/explore.md}",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash"
    },
    "compaction": {
      "prompt": "{file:~/.config/opencode/docs/prompts/compaction.md}",
      "model": "opencode-go/deepseek-v4-flash"
    },
    "vision": {
      "description": "Vision-capable agent for image analysis",
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5",
      "prompt": "You are a vision specialist, when the user provides an image file path, use the Read tool to read it, then describe the image in detail. Return thorough descriptions, extracted text, and all relevant details to the calling agent or user.",
      "options": {},
      "permission": {}
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "instructions": [
    "~/.config/opencode/docs/agent-instructions/workflow.md",
    "~/.config/opencode/docs/agent-instructions/mcp-tools.md",
    "~/.config/opencode/docs/agent-instructions/testing.md",
    "~/.config/opencode/docs/agent-instructions/writing-style.md",
    "~/.config/opencode/docs/agent-instructions/coding.md"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "limit": {
            "context": 372000,
            "input": 350000,
            "output": 48000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 372000,
            "input": 350000,
            "output": 48000
          }
        },
        "gpt-5.6-sol": {
          "limit": {
            "context": 372000,
            "input": 350000,
            "output": 48000
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      }
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "markitdown": {
      "command": [
        "uvx",
        "markitdown-mcp@latest"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [
    "cc-safety-net@latest",
    "@cortexkit/aft-opencode@latest",
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/opencode-openai-auth@latest"
  ],
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "~/.local/share/cortexkit/*": "allow",
      "~/.agents/skills/*": "allow",
      "~/.local/share/opencode/log/*": "allow",
      "~/.config/opencode/*": "allow"
    },
    "skill": "allow",
    "task": {
      "*": "allow"
    },
    "tool": {
      "*": "allow"
    },
    "webfetch": "deny",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "rm -f *": "ask",
      "rm -rf *": "ask",
      "rm -rf /": "ask",
      "dd *": "ask",
      "git checkout *": "ask",
      "git reset *": "ask",
      "git restore *": "ask",
      "git clean *": "ask",
      "git push *": "ask",
      "sh -c *": "ask",
      "git add .": "deny"
    }
  },
  "server": {
    "cors": [
      "http://localhost"
    ],
    "hostname": "0.0.0.0",
    "mdns": true,
    "port": 4096
  }
}
